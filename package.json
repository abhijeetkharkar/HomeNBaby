    "build": "nx run-many -t build",
    "build:baby": "nx build baby-tracker",
    "package:cinema-agent": "powershell -ExecutionPolicy Bypass -File apps/cinema-manager-agent/package-agent.ps1",
    "test": "nx run-many -t test",
    "lint": "nx run-many -t lint",
    "deploy": "nx run-many -t deploy",
    "deploy:baby": "nx deploy baby-tracker",
    "deploy:cinema-api": "nx deploy cinema-manager-api",
    "deploy:cinema-ui": "nx deploy cinema-manager-ui",
    "affected:build": "nx affected -t build",
    "affected:deploy": "nx affected -t deploy",
    "graph": "nx graph"
