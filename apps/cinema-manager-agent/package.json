{
  "name": "cinema-manager-agent",
  "version": "1.0.0",
  "description": "Windows service agent for Cinema Manager file monitoring",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
    "dev": "ts-node src/main.ts",
    "install-service": "node dist/main.js --install",
    "uninstall-service": "node dist/main.js --uninstall",
    "start-service": "node dist/main.js --start",
    "stop-service": "node dist/main.js --stop",
    "build-installer": "electron-builder"
  },
  "dependencies": {
    "chokidar": "^3.5.3",
    "node-windows": "^1.0.0-beta.8",
    "node-fetch": "^3.3.2",
    "fs-extra": "^11.1.1"
  },
  "devDependencies": {
    "@types/node": "^20.8.0",
    "@types/node-windows": "^0.1.6",
    "@types/node-fetch": "^2.6.6",
    "@types/fs-extra": "^11.0.4",
    "electron": "^27.0.0",
    "electron-builder": "^24.6.4",
    "ts-node": "^10.9.1",
    "typescript": "^5.2.2"
  },
  "build": {
    "appId": "com.abhijeetkharkar.cinema-manager-agent",
    "productName": "Cinema Manager Agent",
    "directories": {
      "output": "dist-installer"
    },
    "files": [
      "dist/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "win": {
      "target": "msi",
      "icon": "assets/icon.ico"
    },
    "msi": {
      "oneClick": false,
      "perMachine": true,
      "allowElevation": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "menuCategory": "Cinema Manager"
    }
  },
  "author": "Abhijeet Kharkar",
  "license": "MIT",
  "keywords": [
    "cinema",
    "movie",
    "file-monitor",
    "windows-service",
    "media-management"
  ]
}
